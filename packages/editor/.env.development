# 发布路径
VITE_PUBLIC_PATH=/

# 当前站点URL
VITE_GLOB_ORIGIN=https://localhost:8090/

# Standalone 开发模式：true 时不依赖 astral-service，项目/场景保存在浏览器 IndexedDB
VITE_STANDALONE_MODE=true

#代理接口（VITE_STANDALONE_MODE=false 时使用）
VITE_PROXY_URL=http://127.0.0.1:8080

#ws接口（VITE_STANDALONE_MODE=false 时使用）
VITE_GLOB_SOCKET_URL=ws://127.0.0.1:8080/api/sys/ws